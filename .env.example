# Example environment file for SALT L3 Diamond
# Copy this to .env and fill in real values

# Deployer / Game Server private key (DO NOT COMMIT REAL KEYS)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPC URLs
RPC_URL=http://127.0.0.1:8545
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Optional: For game server / keeper
GAME_SERVER_PRIVATE_KEY=0xYOUR_GAME_SERVER_KEY_HERE
DIAMOND_ADDRESS=

# Frontend (WalletConnect)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Optional flags
USE_PRIVATE_TX=false

# === BuildBear Alpha Testing (changes per sandbox) ===
# Set these before running: npx hardhat run ... --network buildbear
BUILDBEAR_RPC=
BUILDBEAR_CHAIN_ID=

# These are usually auto-written by the deploy script
NEXT_PUBLIC_BUILDBEAR_RPC=
NEXT_PUBLIC_BUILDBEAR_CHAIN_ID=
NEXT_PUBLIC_BUILDBEAR_NETWORK_LABEL=BuildBear(Base)

# Diamond address (set automatically after deploy)
NEXT_PUBLIC_DIAMOND_ADDRESS=
