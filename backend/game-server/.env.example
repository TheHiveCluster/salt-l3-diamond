# SALT Game Server Environment
# Copy to .env and fill in

# Diamond address (from hardhat deploy or ignition)
DIAMOND_ADDRESS=0x...

# RPC for your L3 (localhost for dev, or your OP Stack RPC)
RPC_URL=http://127.0.0.1:8545

# Private key for the authorized game server (must be set via setGameServer on GamePaymentFacet)
GAME_SERVER_PRIVATE_KEY=0x...

# Optional: use private/conditional tx on OP Stack L3
USE_PRIVATE_TX=false

PORT=3001
